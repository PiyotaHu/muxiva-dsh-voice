{
  "name": "@muxiva/dsh-voice",
  "version": "0.1.0-alpha.1",
  "description": "Local-first, full-duplex voice for DeepSeek Harness, orchestrated by Muxiva",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./protocol": "./lib/protocol.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "graph.json",
    "models.lock.json",
    "requirements-macos.txt",
    ".muxiva/nodes/*/node.py",
    ".muxiva/nodes/*/muxiva.node.json",
    "python/muxiva_voice_transport/*.py",
    "scripts",
    "test/e2e_smoke.py",
    "test/speech_text_test.py",
    "benchmarks",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.zh-CN.md"
  ],
  "bin": {
    "muxiva-dsh-voice": "./scripts/cli.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "react"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "muxivaVoice": {
    "muxivaVersion": "0.1.0"
  },
  "scripts": {
    "check": "node --test && PYTHONPATH=python python3 -m unittest discover -s test -p '*_test.py' && node scripts/check-package.mjs && node scripts/check-performance-report.mjs",
    "check:performance": "node scripts/check-performance-report.mjs",
    "test": "npm run check",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "doctor": "node scripts/cli.mjs doctor",
    "models": "node scripts/cli.mjs models",
    "start": "node scripts/cli.mjs start",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "muxiva",
    "voice-agent",
    "speech-to-text",
    "text-to-speech",
    "vad",
    "apple-silicon",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiyotaHu/muxiva-dsh-voice.git"
  },
  "homepage": "https://piyotahu.github.io/muxiva-dsh-voice/",
  "bugs": {
    "url": "https://github.com/PiyotaHu/muxiva-dsh-voice/issues"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.5",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "react": { "optional": true }
  }
}
