{
  "format": "muxiva.node/v1",
  "package_id": "muxiva_qwen3_tts",
  "display_name": "Local Qwen3-TTS for Apple Silicon",
  "node_type": "muxiva.qwen3_tts",
  "language": "python",
  "factory_version": "0.1.0",
  "kind": "transform",
  "entrypoint": "node:Qwen3Tts",
  "category": "algorithm",
  "capability": "speech.tts.local_cancellable_streaming",
  "summary": "Synthesizes multilingual DSH responses locally with Qwen3-TTS and streams cancellable 24 kHz PCM through MLX.",
  "tags": ["local", "qwen3-tts", "mlx", "apple-silicon", "tts", "chinese", "english", "streaming"],
  "ports": [
    {"name":"text_in","direction":"input","frame_type":"text","schema":{"semantics":"synthesis_text","streaming":true}},
    {"name":"signal_in","direction":"input","frame_type":"signal","schema":{"semantics":["graph_control","barge_in"]}},
    {"name":"audio_out","direction":"output","frame_type":"audio","schema":{"encoding":"pcm_s16le","sample_rate_hz":24000,"channels":1,"streaming":true}},
    {"name":"event_out","direction":"output","frame_type":"event","schema":{"semantics":["tts_state"]}}
  ],
  "config_schema": {
    "type": "object",
    "properties": {
      "model_dir": {"type":"string","default":".models/qwen3-tts-12hz-0.6b-customvoice-8bit"},
      "speaker": {"type":"string","enum":["Vivian","Serena","Uncle_Fu","Dylan","Eric","Ryan","Aiden","Ono_Anna","Sohee"],"default":"Serena"},
      "language": {"type":"string","enum":["Auto","Chinese","English"],"default":"Auto"},
      "instruct": {"type":"string","maxLength":512,"default":"用温柔、自然、亲切的年轻女性声音说话，语速舒缓，语调柔和，使用标准普通话，不要夸张。"},
      "streaming_interval": {"type":"number","minimum":0.16,"maximum":2.0,"default":0.32},
      "pcm_chunk_ms": {"type":"integer","minimum":20,"maximum":100,"default":40},
      "playback_lookahead_ms": {"type":"integer","minimum":80,"maximum":240,"default":160}
    },
    "additionalProperties": false
  }
}
